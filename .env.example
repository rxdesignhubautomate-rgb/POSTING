# Without an admin password, the app presents a clearly labeled local-browser demo.
DEMO_MODE=false
ADMIN_PASSWORD=
# Generate a random secret of at least 32 characters.
SESSION_SECRET=
# Add Neon Postgres through the Vercel Marketplace. Either URL name is accepted.
DATABASE_URL=
# Create a PUBLIC Vercel Blob store. Marketing media has public, unguessable URLs.
BLOB_READ_WRITE_TOKEN=
# Exact store origin, e.g. https://yourstore.public.blob.vercel-storage.com
BLOB_PUBLIC_ORIGIN=
PUBLER_API_KEY=
PUBLER_WORKSPACE_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
